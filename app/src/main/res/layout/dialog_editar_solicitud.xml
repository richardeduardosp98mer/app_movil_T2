<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dialog_padding">

        <ImageView
            android:id="@+id/imageViewEditar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/imagen_tarjeta_height"
            android:contentDescription="@string/imagen_solicitud"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textViewImagenEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:text="@string/imagen_se_conserva"
            android:textColor="@color/gris_texto"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutNombreEditar"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_medium"
            android:hint="@string/hint_nombre">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextNombreEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutDescripcionEditar"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_medium"
            android:hint="@string/hint_descripcion">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextDescripcionEditar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/description_height"
                android:gravity="top"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_medium"
            android:labelFor="@id/autoCompleteCategoriaEditar"
            android:text="@string/label_categoria"
            android:textColor="@color/azul_oscuro"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutCategoriaEditar"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/autoCompleteCategoriaEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                tools:ignore="EditableContentDescCheck" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_medium"
            android:text="@string/label_prioridad"
            android:textColor="@color/azul_oscuro"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupPrioridadEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioPrioridadBajaEditar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prioridad_baja" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioPrioridadMediaEditar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prioridad_media" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioPrioridadAltaEditar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prioridad_alta" />
        </RadioGroup>

        <TextView
            android:id="@+id/textViewErrorPrioridadEditar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_prioridad"
            android:textColor="@color/error"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
